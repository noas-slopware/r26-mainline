# Device package for the Gustard R26 streamer: the kernel, the watchdog feeder and the step
# that puts the kernel where the stock U-Boot loads it.
maintainer="Noa Himesaka <himesaka@noa.codes>"
pkgname=device-gustard-r26
pkgver=1
pkgrel=1
pkgdesc="Gustard R26 streamer: kernel deploy and watchdog"
url="https://github.com/noas-slopware/r26-mainline"
arch="armv7"
license="MIT"
options="!check"
depends="linux-gustard-r26 busybox openrc"
install="$pkgname.post-install $pkgname.post-upgrade"
triggers="$pkgname.trigger=/boot/gustard-r26"
subpackages="$pkgname-repo:_repo:noarch"
source="
	hw-watchdog.initd
	r26-boot-deploy
	gustard-r26.list
	r26-mainline-1cc0db58.rsa.pub
	"

package() {
	install -Dm755 "$srcdir"/hw-watchdog.initd "$pkgdir"/etc/init.d/hw-watchdog
	install -Dm755 "$srcdir"/r26-boot-deploy "$pkgdir"/usr/sbin/r26-boot-deploy
}

_repo() {
	pkgdesc="Gustard R26 streamer: this package repository and its signing key"
	depends=""
	# apk-tools 3 on Alpine 3.24 reads repositories.d and keys from /etc/apk and /lib/apk
	# (not /usr/lib/apk: 3.24 is not /usr-merged)
	install -Dm644 "$srcdir"/gustard-r26.list "$subpkgdir"/lib/apk/repositories.d/gustard-r26.list
	install -Dm644 "$srcdir"/r26-mainline-1cc0db58.rsa.pub \
		"$subpkgdir"/lib/apk/keys/r26-mainline-1cc0db58.rsa.pub
}
