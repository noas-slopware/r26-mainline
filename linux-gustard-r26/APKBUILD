# Linux for the Gustard R26 streamer (SigmaStar SSD202D): stable 7.3.6 plus the
# r26-mainline series (patches/linux on the senpai branch of noas-slopware/r26-mainline;
# the same files are next to this APKBUILD) and the production config fragment
# (config/r26.config there), applied on allnoconfig as the series was tested.
#
# The stock U-Boot loads /GustardCore and /00 from the card's first partition and passes
# "root=/dev/mmcblk0p1 rw" itself. Two images are built, differing only in the built-in
# command line that is appended after U-Boot's:
#   zImage          "... ro"                     root on the first partition (the image)
#   zImage-root-p2  "... root=/dev/mmcblk0p2 ro"  root on the second partition, for cards
#                                                 that keep the stock Debian on the first
# device-gustard-r26 copies the right one to /GustardCore (r26-boot-deploy).
maintainer="Noa Himesaka <himesaka@noa.codes>"
pkgname=linux-gustard-r26
pkgver=7.3.6
pkgrel=0
pkgdesc="Linux for the Gustard R26 streamer (SigmaStar SSD202D)"
url="https://github.com/noas-slopware/r26-mainline"
arch="armv7"
license="GPL-2.0-only"
options="!strip !check !tracedeps"
makedepends="bc bison clang diffutils findutils flex lld llvm openssl-dev perl python3 xz"
source="https://cdn.kernel.org/pub/linux/kernel/v7.x/linux-$pkgver.tar.xz
	config-gustard-r26.fragment
	0001-mfd-syscon-add-use-raw-spinlock-property.patch
	0002-gpio-msc313-add-SSD20xD-interrupts-and-register-lock.patch
	0003-irqchip-add-SigmaStar-SSD20xD-GPI-and-MStar-PM-inter.patch
	0004-pinctrl-mstar-add-MStar-SigmaStar-pin-controllers.patch
	0005-clk-mstar-add-clkgen-clock-muxes-and-the-UPLL-LPLL-M.patch
	0006-clocksource-msc313e-set-the-divider-for-timer0-too.patch
	0007-phy-mstar-add-the-MSC313-USB-PHY-with-SSD20xD-bring-.patch
	0008-usb-ehci-add-MStar-SigmaStar-FUSBH200-glue-and-a-por.patch
	0009-net-phy-add-the-MStar-MSC313-internal-PHY.patch
	0010-net-macb-add-MStar-SigmaStar-EMAC-support.patch
	0011-mmc-add-a-SigmaStar-SSD20xD-SD-host-controller-drive.patch
	0012-ARM-dts-sigmastar-update-the-Infinity2M-dtsi-from-li.patch
	0013-ARM-dts-sigmastar-add-the-Gustard-R26-streamer.patch
	0014-misc-add-Gustard-R26-boot-stage-breadcrumbs-test-onl.patch
	0015-usb-ehci-fotg210-don-t-touch-the-UHC-before-the-MSta.patch
	0016-watchdog-msc313e-keep-running-through-a-restart.patch
	0017-ARM-dts-sigmastar-gustard-r26-production-settings.patch
	0018-misc-r26-marker-breadcrumbs-in-the-POR-register-coun.patch
	0019-gpio-add-a-driver-for-the-MStar-SigmaStar-SAR-pads-a.patch
	0020-ARM-dts-sigmastar-gustard-r26-describe-the-CPU-core-.patch
	0021-watchdog-msc313e-support-nowayout.patch
	0022-net-macb-MStar-derive-a-stable-MAC-address-from-the-.patch
	0023-net-macb-MStar-read-the-statistics-counters-through-.patch
	0024-net-macb-MStar-run-the-TX-queue-the-way-the-vendor-d.patch
	0025-ARM-mstar-keep-AXI-exclusive-access-on-and-serialise.patch
	0026-ARM-dts-sigmastar-gustard-r26-hold-GPIO12-amp-gpio-l.patch
	"
builddir="$srcdir/linux-$pkgver"
_dtb=sigmastar/mstar-infinity2m-ssd202d-gustard-r26.dtb
_cmdline_base="console=ttyS0,115200 earlycon"

_make() {
	make -C "$builddir" O="$srcdir/build" ARCH=arm LLVM=1 \
		KBUILD_BUILD_VERSION="$pkgrel" KBUILD_BUILD_USER=alpine KBUILD_BUILD_HOST=gustard-r26 "$@"
}

# allnoconfig with the fragment, then a check that every option of it stuck (allnoconfig
# silently drops what it cannot satisfy)
_config() { # <command line>
	sed "s|^CONFIG_CMDLINE=.*|CONFIG_CMDLINE=\"$1\"|" "$srcdir"/config-gustard-r26.fragment \
		> "$srcdir"/fragment
	_make KCONFIG_ALLCONFIG="$srcdir"/fragment allnoconfig >/dev/null
	local l bad=0
	while IFS= read -r l; do
		case "$l" in
		CONFIG_*=n|'#'*|'') ;;
		CONFIG_*) grep -qxF "$l" "$srcdir"/build/.config || { echo "did not stick: $l"; bad=1; } ;;
		esac
	done < "$srcdir"/fragment
	return $bad
}

prepare() {
	default_prepare
	mkdir -p "$srcdir"/build
}

build() {
	unset LDFLAGS
	# root from U-Boot (first partition), mounted read-only first so fsck can run
	_config "$_cmdline_base ro"
	_make zImage dtbs
	cp "$srcdir"/build/arch/arm/boot/zImage "$srcdir"/zImage
	cp "$srcdir"/build/include/config/kernel.release "$srcdir"/kernel.release
	# the same kernel with the root on the second partition: only CONFIG_CMDLINE changes, so
	# this is an incremental build of the few objects that use it
	_config "$_cmdline_base root=/dev/mmcblk0p2 ro"
	_make zImage
	cp "$srcdir"/build/arch/arm/boot/zImage "$srcdir"/zImage-root-p2
}

package() {
	install -Dm644 "$srcdir"/zImage "$pkgdir"/boot/gustard-r26/zImage
	install -Dm644 "$srcdir"/zImage-root-p2 "$pkgdir"/boot/gustard-r26/zImage-root-p2
	install -Dm644 "$srcdir"/build/arch/arm/boot/dts/$_dtb "$pkgdir"/boot/gustard-r26/gustard-r26.dtb
	install -Dm644 "$srcdir"/kernel.release "$pkgdir"/usr/share/kernel/gustard-r26/kernel.release
}
