 #define MACB_CAPS_USRIO_HAS_REFCLK_SOURCE	BIT(27)
 #define MACB_CAPS_USRIO_HAS_TSUCLK_SOURCE	BIT(28)
+/* MStar/SigmaStar EMAC: 32-bit registers split over two 16-bit RIU slots */
+#define MACB_CAPS_MSTAR_RIU			BIT(29)
+/* MStar/SigmaStar EMAC: 4-entry TX queue, free count encoded in TSR */
+#define MACB_CAPS_MSTAR_TXQ			BIT(30)
 
 /* LSO settings */
 #define MACB_LSO_UFO_ENABLE			0x01
@@ -1242,6 +1253,7 @@ struct macb_config {
 	int	(*init)(struct platform_device *pdev);
 	unsigned int		max_tx_length;
 	int	jumbo_max_len;
+	unsigned int		rm9200_txq_len;
 	const struct macb_usrio_config *usrio;
 };
 
@@ -1344,8 +1356,15 @@ struct macb {
 
 	phy_interface_t		phy_interface;
 
-	/* AT91RM9200 transmit queue (1 on wire + 1 queued) */
-	struct macb_tx_skb	rm9200_txq[2];
+	/*
+	 * AT91RM9200-style transmit queue: 1 on wire + 1 queued on the
+	 * AT91RM9200, 4 on MStar/SigmaStar EMACs.
+	 */
+#define MACB_RM9200_TXQ_MAX	4
+	struct macb_tx_skb	rm9200_txq[MACB_RM9200_TXQ_MAX];
+	unsigned int		rm9200_txq_len;
+	unsigned int		rm9200_tx_tail;
+	unsigned int		rm9200_tx_len;
 	unsigned int		max_tx_length;
 
 	u64			ethtool_stats[GEM_STATS_LEN + QUEUE_STATS_LEN * MACB_MAX_QUEUES];
diff --git a/drivers/net/ethernet/cadence/macb_main.c b/drivers/net/ethernet/cadence/macb_main.c
index ab9f6f25cd..18a1b50256 100644
--- a/drivers/net/ethernet/cadence/macb_main.c
+++ b/drivers/net/ethernet/cadence/macb_main.c
@@ -39,6 +39,7 @@
 #include <linux/udp.h>
 #include <linux/gcd.h>
 #include <net/pkt_sched.h>
+#include <soc/mstar/riuxiu.h>
 #include "macb.h"
 
 /* This structure is only used for MACB on SiFive FU540 devices */
@@ -218,6 +219,17 @@ static void hw_writel(struct macb *bp, int offset, u32 value)
 	writel_relaxed(value, bp->regs + offset);
 }
 
+/* MStar/SigmaStar EMAC: each 32-bit register is split over two 16-bit RIU slots */
+static u32 hw_readl_riu(struct macb *bp, int offset)
+{
+	return riu_readl(bp->regs, offset);
+}
+
+static void hw_writel_riu(struct macb *bp, int offset, u32 value)
+{
+	riu_writel(bp->regs, offset, value);
+}
+
 /* Find the CPU endianness by using the loopback bit of NCR register. When the
  * CPU is in big endian we need to program swapped mode for management
  * descriptor access.
@@ -5042,6 +5054,11 @@ static int at91ether_start(struct macb *bp)
 	/* Reset buffer index */
 	queue->rx_tail = 0;
 
+	/* Reset the transmit queue */
+	memset(bp->rm9200_txq, 0, sizeof(bp->rm9200_txq));
+	bp->rm9200_tx_tail = 0;
+	bp->rm9200_tx_len = 0;
+
 	/* Program address of descriptor list in Rx Buffer Queue register */
 	macb_writel(bp, RBQP, queue->rx_ring_dma);
 
@@ -5055,6 +5072,7 @@ static int at91ether_start(struct macb *bp)
 			     MACB_BIT(ISR_TUND)	|
 			     MACB_BIT(ISR_RLE)	|
 			     MACB_BIT(TCOMP)	|
+			     MACB_BIT(RM9200_TBRE)	|
 			     MACB_BIT(ISR_ROVR)	|
 			     MACB_BIT(HRESP));
 
@@ -5071,6 +5089,7 @@ static void at91ether_stop(struct macb *bp)
 			     MACB_BIT(ISR_TUND)	|
 			     MACB_BIT(ISR_RLE)	|
 			     MACB_BIT(TCOMP)	|
+			     MACB_BIT(RM9200_TBRE)	|
 			     MACB_BIT(ISR_ROVR) |
 			     MACB_BIT(HRESP));
 
@@ -5135,43 +5154,112 @@ static int at91ether_close(struct net_device *netdev)
 	return 0;
 }
 
+/* Number of frames the transmitter can still accept */
+static unsigned int at91ether_txqfree(struct macb *bp, u32 tsr)
+{
+	unsigned int n;
+
+	if (bp->caps & MACB_CAPS_MSTAR_TXQ) {
+		/* MStar: one "slot idle" bit per FIFO entry in TSR[4:3] and TSR[12:7] */
+		n = hweight32(((tsr >> 3) & 0x3) | (((tsr >> 7) & 0x3f) << 2));
+		return n > 4 ? n - 4 : 0;
+	}
+
+	/*
+	 * AT91RM9200:
+	 *   - all pending packets transmitted (TGO, implies BNQ): 2
+	 *   - only first packet transmitted (!TGO && BNQ): 1
+	 *   - two frames pending (!TGO && !BNQ): 0
+	 * TGO ("transmit go") is called "IDLE" on RM9200.
+	 */
+	return (tsr & MACB_BIT(TGO)) ? 2 :
+	       (tsr & MACB_BIT(RM9200_BNQ)) ? 1 : 0;
+}
+
 /* Transmit packet */
 static netdev_tx_t at91ether_start_xmit(struct sk_buff *skb,
 					struct net_device *netdev)
 {
 	struct macb *bp = netdev_priv(netdev);
 	struct device *dev = &bp->pdev->dev;
+	netdev_tx_t ret = NETDEV_TX_OK;
+	bool busy = false, map_err = false;
+	unsigned long flags;
+	unsigned int desc;
+	u32 tsr;
 
-	if (macb_readl(bp, TSR) & MACB_BIT(RM9200_BNQ)) {
-		int desc = 0;
-
-		netif_stop_queue(netdev);
+	spin_lock_irqsave(&bp->lock, flags);
 
-		/* Store packet information (to free when Tx completed) */
-		bp->rm9200_txq[desc].skb = skb;
-		bp->rm9200_txq[desc].size = skb->len;
-		bp->rm9200_txq[desc].mapping = dma_map_single(dev, skb->data,
-							      skb->len,
-							      DMA_TO_DEVICE);
-		if (dma_mapping_error(dev, bp->rm9200_txq[desc].mapping)) {
-			dev_kfree_skb_any(skb);
-			netdev->stats.tx_dropped++;
-			netdev_err(netdev, "%s: DMA mapping error\n", __func__);
-			return NETDEV_TX_OK;
+	/* Queue full but xmit got called anyway */
+	if (bp->rm9200_tx_len == bp->rm9200_txq_len)
+		goto busy;
+
+	/* Check TSR in case we lost track */
+	tsr = macb_readl(bp, TSR);
+	if (at91ether_txqfree(bp, tsr) == 0)
+		goto busy;
+
+	/* Store packet information (to free when Tx completed) */
+	desc = bp->rm9200_tx_tail;
+	bp->rm9200_txq[desc].skb = skb;
+	bp->rm9200_txq[desc].size = skb->len;
+	bp->rm9200_txq[desc].mapping = dma_map_single(dev, skb->data,
+						      skb->len,
+						      DMA_TO_DEVICE);
+	if (dma_mapping_error(dev, bp->rm9200_txq[desc].mapping)) {
+		bp->rm9200_txq[desc].skb = NULL;
+		dev_kfree_skb_any(skb);
+		netdev->stats.tx_dropped++;
+		map_err = true;
+		goto out;
+	}
+
+	/* Set address of the data in the Transmit Address register */
+	macb_writel(bp, TAR, bp->rm9200_txq[desc].mapping);
+	/* Set length of the packet in the Transmit Control register */
+	macb_writel(bp, TCR, skb->len);
+
+	/* The MStar EMAC flags a frame it did not accept with OVR */
+	if (bp->caps & MACB_CAPS_MSTAR_TXQ) {
+		tsr = macb_readl(bp, TSR);
+		if (tsr & MACB_BIT(RM9200_OVR)) {
+			macb_writel(bp, TSR, MACB_BIT(RM9200_OVR));
+			dma_unmap_single(dev, bp->rm9200_txq[desc].mapping,
+					 bp->rm9200_txq[desc].size,
+					 DMA_TO_DEVICE);
+			bp->rm9200_txq[desc].skb = NULL;
+			netdev->stats.tx_errors++;
+			ret = NETDEV_TX_BUSY;
+			goto out;
 		}
+	}
 
-		/* Set address of the data in the Transmit Address register */
-		macb_writel(bp, TAR, bp->rm9200_txq[desc].mapping);
-		/* Set length of the packet in the Transmit Control register */
-		macb_writel(bp, TCR, skb->len);
+	bp->rm9200_tx_tail = (desc + 1) % bp->rm9200_txq_len;
+	bp->rm9200_tx_len++;
 
-	} else {
-		netdev_err(netdev, "%s called, but device is busy!\n",
-			   __func__);
-		return NETDEV_TX_BUSY;
-	}
+	/* Stop the queue if we are full up */
+	if (bp->rm9200_tx_len == bp->rm9200_txq_len)
+		netif_stop_queue(netdev);
 
-	return NETDEV_TX_OK;
+	goto out;
+
+busy:
+	netif_stop_queue(netdev);
+	busy = true;
+	ret = NETDEV_TX_BUSY;
+out:
+	spin_unlock_irqrestore(&bp->lock, flags);
+	/*
+	 * Never print while holding bp->lock: with netconsole on this
+	 * interface the message re-enters start_xmit through netpoll.
+	 */
+	if (busy)
+		net_dbg_ratelimited("%s: %s called, but device is busy\n",
+				    netdev->name, __func__);
+	if (map_err)
+		net_err_ratelimited("%s: %s: DMA mapping error\n",
+				    netdev->name, __func__);
+	return ret;
 }
 
 /* Extract received frame from buffer descriptors and sent to upper layers.
@@ -5238,23 +5326,34 @@ static irqreturn_t at91ether_interrupt(int irq, void *dev_id)
 		at91ether_rx(netdev);
 
 	/* Transmit complete */
-	if (intstatus & MACB_BIT(TCOMP)) {
+	if (intstatus & (MACB_BIT(TCOMP) | MACB_BIT(RM9200_TBRE))) {
+		unsigned int done;
+
 		/* The TCOM bit is set even if the transmission failed */
 		if (intstatus & (MACB_BIT(ISR_TUND) | MACB_BIT(ISR_RLE)))
 			netdev->stats.tx_errors++;
 
-		desc = 0;
-		if (bp->rm9200_txq[desc].skb) {
-			dev_consume_skb_irq(bp->rm9200_txq[desc].skb);
-			bp->rm9200_txq[desc].skb = NULL;
-			dma_unmap_single(&bp->pdev->dev,
-					 bp->rm9200_txq[desc].mapping,
-					 bp->rm9200_txq[desc].size,
-					 DMA_TO_DEVICE);
-			netdev->stats.tx_packets++;
-			netdev->stats.tx_bytes += bp->rm9200_txq[desc].size;
+		spin_lock(&bp->lock);
+		done = at91ether_txqfree(bp, macb_readl(bp, TSR));
+		while (bp->rm9200_tx_len > 0 && done > 0) {
+			desc = (bp->rm9200_tx_tail + bp->rm9200_txq_len -
+				bp->rm9200_tx_len) % bp->rm9200_txq_len;
+			if (bp->rm9200_txq[desc].skb) {
+				dev_consume_skb_irq(bp->rm9200_txq[desc].skb);
+				bp->rm9200_txq[desc].skb = NULL;
+				dma_unmap_single(&bp->pdev->dev,
+						 bp->rm9200_txq[desc].mapping,
+						 bp->rm9200_txq[desc].size,
+						 DMA_TO_DEVICE);
+				netdev->stats.tx_packets++;
+				netdev->stats.tx_bytes += bp->rm9200_txq[desc].size;
+			}
+			bp->rm9200_tx_len--;
+			done--;
 		}
-		netif_wake_queue(netdev);
+		if (bp->rm9200_tx_len < bp->rm9200_txq_len)
+			netif_wake_queue(netdev);
+		spin_unlock(&bp->lock);
 	}
 
 	/* Work-around for EMAC Errata section 41.3.1 */
@@ -5265,8 +5364,10 @@ static irqreturn_t at91ether_interrupt(int irq, void *dev_id)
 		macb_writel(bp, NCR, ctl | MACB_BIT(RE));
 	}
 
-	if (intstatus & MACB_BIT(ISR_ROVR))
+	if (intstatus & MACB_BIT(ISR_ROVR)) {
 		netdev_err(netdev, "ROVR error\n");
+		bp->hw_stats.macb.rx_overruns++;
+	}
 
 	return IRQ_HANDLED;
 }
@@ -5654,6 +5755,74 @@ static const struct macb_config sama5d4_config = {
 	.usrio = &at91_default_usrio,
 };
 
+static int msc313_clk_init(struct platform_device *pdev, struct clk **pclk,
+			   struct clk **hclk, struct clk **tx_clk,
+			   struct clk **rx_clk, struct clk **tsu_clk)
+{
+	struct clk *rx_ref, *tx_ref;
+	int err;
+
+	/* Extra RMII reference clocks some boards need */
+	rx_ref = devm_clk_get_optional_enabled(&pdev->dev, "rx_ref");
+	if (IS_ERR(rx_ref))
+		return PTR_ERR(rx_ref);
+
+	tx_ref = devm_clk_get_optional_enabled(&pdev->dev, "tx_ref");
+	if (IS_ERR(tx_ref))
+		return PTR_ERR(tx_ref);
+
+	err = macb_clk_init_dflt(pdev, pclk, hclk, tx_clk, rx_clk, tsu_clk);
+	return err;
+}
+
+static int msc313_init(struct platform_device *pdev)
+{
+	struct net_device *netdev = platform_get_drvdata(pdev);
+	struct macb *bp = netdev_priv(netdev);
+	struct device_node *phy_node;
+
+	/*
+	 * Whatever ran before us (vendor kernel, bootloader) may have left
+	 * the MAC running: stop RX/TX, mask everything and drain pending
+	 * status before at91ether_init() requests the interrupt.
+	 */
+	macb_writel(bp, NCR, 0);
+	macb_writel(bp, IDR, ~0U);
+	macb_readl(bp, ISR);
+	macb_writel(bp, RSR, ~0U);
+	macb_writel(bp, TSR, ~0U);
+
+	/*
+	 * Switch to "software rx descriptors". Without this RX doesn't
+	 * work the way this driver expects and the controller corrupts
+	 * memory, so this is required.
+	 */
+	macb_writel(bp, MSC313_13A, 0x100);
+	macb_writel(bp, MSC313_JULIAN_104, 1);
+
+	/*
+	 * Magic needed for an external (RMII) PHY on SSD20xD. The
+	 * integrated PHY needs nothing here.
+	 */
+	phy_node = of_parse_phandle(pdev->dev.of_node, "phy-handle", 0);
+	if (phy_node) {
+		if (!of_property_read_bool(phy_node, "phy-is-integrated"))
+			macb_writel(bp, MSC313_JULIAN_100, 0xf017);
+		of_node_put(phy_node);
+	}
+
+	return at91ether_init(pdev);
+}
+
+static const struct macb_config msc313_config = {
+	.caps = MACB_CAPS_NEEDS_RSTONUBR | MACB_CAPS_MACB_IS_EMAC |
+		MACB_CAPS_MSTAR_RIU | MACB_CAPS_MSTAR_TXQ,
+	.clk_init = msc313_clk_init,
+	.init = msc313_init,
+	.usrio = &at91_default_usrio,
+	.rm9200_txq_len = 4,
+};
+
 static const struct macb_config emac_config = {
 	.caps = MACB_CAPS_NEEDS_RSTONUBR | MACB_CAPS_MACB_IS_EMAC |
 		MACB_CAPS_USRIO_HAS_MII,
@@ -5758,6 +5927,8 @@ static const struct macb_config pic64hpsc_config = {
 };
 
 static const struct of_device_id macb_dt_ids[] = {
+	{ .compatible = "mstar,msc313-emac", .data = &msc313_config },
+	{ .compatible = "mstar,msc313e-emac", .data = &msc313_config },
 	{ .compatible = "cdns,at91sam9260-macb", .data = &at91sam9260_config },
 	{ .compatible = "cdns,macb" },
 	{ .compatible = "cdns,np4-macb", .data = &np4_config },
@@ -5860,6 +6031,11 @@ static int macb_probe(struct platform_device *pdev)
 		bp->macb_reg_readl = hw_readl;
 		bp->macb_reg_writel = hw_writel;
 	}
+	if (macb_config->caps & MACB_CAPS_MSTAR_RIU) {
+		bp->macb_reg_readl = hw_readl_riu;
+		bp->macb_reg_writel = hw_writel_riu;
+	}
+	bp->rm9200_txq_len = macb_config->rm9200_txq_len ?: 2;
 	bp->num_queues = num_queues;
 	bp->dma_burst_length = macb_config->dma_burst_length;
 	bp->pclk = pclk;
diff --git a/include/soc/mstar/riuxiu.h b/include/soc/mstar/riuxiu.h
new file mode 100644
index 0000000000..846052ec4f
--- /dev/null
+++ b/include/soc/mstar/riuxiu.h
@@ -0,0 +1,102 @@
+/* SPDX-License-Identifier: GPL-2.0+ */
+
+#ifndef _SOC_MSTAR_RIUXIU_H_
+#define _SOC_MSTAR_RIUXIU_H_
+
+#include <linux/io.h>
+
+/*
+ * RIU accessors.
+ *
+ * These are for accessing split 32bit registers in MStar and
+ * third party IPs.
+ *
+ * To access a split 32bit register in an MStar IP use
+ * the _abs() version with the full address for the lower
+ * half of the register.
+ *
+ * To access a split 32bit register for a third party IP where
+ * the offset from the start of the registers needs to be
+ * doubled to get the right address use the non-abs version.
+ */
+static inline u32 riu_readl_abs(void __iomem *base)
+{
+	return readw(base + 4) << 16 | readw(base);
+}
+
+static inline u32 riu_readl(void __iomem *base, unsigned int offset)
+{
+	return riu_readl_abs(base + (offset * 2));
+}
+
+static inline u32 riu_readl_relaxed_abs(void __iomem *base)
+{
+	return readw_relaxed(base + 4) << 16 | readw_relaxed(base);
+}
+
+static inline u32 riu_readl_relaxed(void __iomem *base, unsigned int offset)
+{
+	return riu_readl_relaxed_abs(base + (offset * 2));
+}
+
+static inline void riu_writel_relaxed_abs(void __iomem *base, u32 value)
+{
+	/*
+	 * Do not change this order. For EMAC at least the write order
+	 * must be the lower half and then the upper half otherwise it
+	 * doesn't work because writing the transmit buffer register no
+	 * longer triggers sending a frame.
+	 */
+	writew_relaxed(value, base);
+	writew_relaxed(value >> 16, base + 4);
+}
+
+static inline void riu_writel_relaxed(void __iomem *base, unsigned int offset, u32 value)
+{
+	riu_writel_relaxed_abs(base + (offset * 2), value);
+}
+
+static inline void riu_writel_abs(void __iomem *base, u32 value)
+{
+	/*
+	 * Do not change this order. For EMAC at least the write order
+	 * must be the lower half and then the upper half otherwise it
+	 * doesn't work because writing the transmit buffer register no
+	 * longer triggers sending a frame.
+	 */
+	writew(value, base);
+	writew(value >> 16, base + 4);
+}
+
+static inline void riu_writel(void __iomem *base, unsigned int offset, u32 value)
+{
+	riu_writel_abs(base + (offset * 2), value);
+}
+
+/*
+ * XIU accessors, use these whenever possible for third party IPs.
+ * For MStar IPs just use plain readl(), writel() etc.
+ */
+
+static inline u32 xiu_readl(void __iomem *base, unsigned int offset)
+{
+	return readl(base + (offset * 2));
+}
+
+static inline u32 xiu_readl_relaxed(void __iomem *base, unsigned int offset)
+{
+	return readl_relaxed(base + (offset * 2));
+}
+
+static inline void xiu_writel(void __iomem *base, unsigned int offset, u32 value)
+{
+
+	writel_relaxed(value, base + (offset * 2));
+}
+
+static inline void xiu_writel_relaxed(void __iomem *base, unsigned int offset, u32 value)
+{
+	writel_relaxed(value, base + (offset * 2));
+}
+
+#endif
