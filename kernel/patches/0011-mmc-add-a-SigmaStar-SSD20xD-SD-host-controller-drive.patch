--- a/drivers/mmc/host/Kconfig
+++ b/drivers/mmc/host/Kconfig
@@ -367,6 +367,14 @@ config MMC_SDHCI_S3C
 
 	  If unsure, say N.
 
+config MMC_SSTAR_SDIO
+	tristate "SigmaStar SSD20xD SD host controller"
