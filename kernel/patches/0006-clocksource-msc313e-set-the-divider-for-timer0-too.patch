From c5ada6b79633b977c9c91abf490c3a53664d4ac2 Mon Sep 17 00:00:00 2001
From: Noa Himesaka <himesaka@noa.codes>
Date: Tue, 24 Nov 2026 13:26:54 +0900
Subject: [PATCH 06/14] clocksource: msc313e: set the divider for timer0 too

Taken from the final state of the linux-chenxing mstar_v6_7_rebase branch
(https://github.com/linux-chenxing/linux, Daniel Palmer et al.) and ported
to v7.3.

Assisted-by: Claude:claude-opus-5-5
---
 drivers/clocksource/timer-msc313e.c | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/drivers/clocksource/timer-msc313e.c b/drivers/clocksource/timer-msc313e.c
index e4b9e3f161..2df6718122 100644
--- a/drivers/clocksource/timer-msc313e.c
+++ b/drivers/clocksource/timer-msc313e.c
@@ -207,6 +207,12 @@ static int __init msc313e_clksrc_init(struct device_node *np)
 	if (ret)
 		return ret;
 
+	if (of_device_is_compatible(np, "sstar,ssd20xd-timer")) {
+		to.of_clk.rate = clk_get_rate(to.of_clk.clk) / MSC313E_CLK_DIVIDER;
+		to.of_clk.period = DIV_ROUND_UP(to.of_clk.rate, HZ);
+		writew(MSC313E_CLK_DIVIDER - 1, timer_of_base(&to) + MSC313E_REG_TIMER_DIVIDE);
+	}
+
 	msc313e_clksrc = timer_of_base(&to);
 	reg = readw(msc313e_clksrc + MSC313E_REG_CTRL);
 	reg |= MSC313E_REG_CTRL_TIMER_EN;
-- 
2.56.0

