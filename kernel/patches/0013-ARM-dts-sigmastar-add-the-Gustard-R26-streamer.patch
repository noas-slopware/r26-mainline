From a7ce7c4acfea3e58fb5d2bd2b14521ec9ed2950b Mon Sep 17 00:00:00 2001
From: Noa Himesaka <himesaka@noa.codes>
Date: Tue, 24 Nov 2026 13:26:55 +0900
Subject: [PATCH 13/26] ARM: dts: sigmastar: add the Gustard R26 streamer

SSD202D board in the Gustard R26 DAC: EMAC with the internal PHY, the
DAC's XMOS USB Audio 2.0 on the third USB port, the internal microSD on
the SD host, uart0 as plain ns16550a, and the stock kernel's CMA range
kept reserved.

Assisted-by: Claude:claude-opus-5-5
---
 arch/arm/boot/dts/sigmastar/Makefile          |  1 +
 .../mstar-infinity2m-ssd202d-gustard-r26.dts  | 92 +++++++++++++++++++
 2 files changed, 93 insertions(+)
 create mode 100644 arch/arm/boot/dts/sigmastar/mstar-infinity2m-ssd202d-gustard-r26.dts

diff --git a/arch/arm/boot/dts/sigmastar/Makefile b/arch/arm/boot/dts/sigmastar/Makefile
index b07eaf5d8a..4e1032017d 100644
--- a/arch/arm/boot/dts/sigmastar/Makefile
+++ b/arch/arm/boot/dts/sigmastar/Makefile
@@ -4,6 +4,7 @@ dtb-$(CONFIG_ARCH_MSTARV7) += \
 	mstar-infinity2m-ssd202d-100ask-dongshanpione.dtb \
 	mstar-infinity2m-ssd202d-miyoo-mini.dtb \
 	mstar-infinity2m-ssd202d-wirelesstag-ido-sbc2d06-v1b-22w.dtb \
+	mstar-infinity2m-ssd202d-gustard-r26.dtb \
 	mstar-infinity2m-ssd202d-ssd201htv2.dtb \
