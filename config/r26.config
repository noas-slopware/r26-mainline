# Gustard R26 streamer (SigmaStar SSD202D), applied on top of allnoconfig.
# Distro-agnostic: plain systemd-capable armhf kernel, everything built in.

# Platform
CONFIG_MMU=y
CONFIG_ARCH_MULTI_V7=y
CONFIG_ARCH_MSTARV7=y
CONFIG_MACH_INFINITY=y
CONFIG_SMP=y
CONFIG_NR_CPUS=2
CONFIG_HOTPLUG_CPU=y
CONFIG_VFP=y
CONFIG_NEON=y
CONFIG_KERNEL_MODE_NEON=y
CONFIG_AEABI=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_NO_HZ_IDLE=y
CONFIG_PREEMPT_VOLUNTARY=y
CONFIG_CPU_IDLE=y
CONFIG_ARM_CPUIDLE=y

# Boot
CONFIG_CMDLINE="console=ttyS0,115200 earlycon"
CONFIG_CMDLINE_EXTEND=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_XZ=y
CONFIG_KERNEL_XZ=y
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y

CONFIG_PANIC_TIMEOUT=3
CONFIG_MULTIUSER=y
CONFIG_SYSFS_SYSCALL=y
CONFIG_FHANDLE=y
CONFIG_POSIX_TIMERS=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_SHMEM=y
CONFIG_AIO=y
CONFIG_IO_URING=y
CONFIG_ADVISE_SYSCALLS=y
CONFIG_MEMBARRIER=y
CONFIG_KALLSYMS=y
CONFIG_ELF_CORE=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_SWAP=y
CONFIG_ZSWAP=y
CONFIG_CMA=y
CONFIG_DMA_CMA=y
CONFIG_CMA_SIZE_MBYTES=4

# systemd needs
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_CGROUP_SCHED=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CPUSETS=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_SYSVIPC=y
CONFIG_INOTIFY_USER=y
CONFIG_FANOTIFY=y
CONFIG_AUTOFS_FS=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_CONFIGFS_FS=y
CONFIG_DMIID=n
CONFIG_UNIX=y
CONFIG_UEVENT_HELPER=n
CONFIG_STANDALONE=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# Filesystems
CONFIG_BLOCK=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_VFAT_FS=y
CONFIG_FUSE_FS=y
CONFIG_OVERLAY_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y
CONFIG_MSDOS_PARTITION=y
CONFIG_EFI_PARTITION=y
CONFIG_PARTITION_ADVANCED=y

# SoC drivers (chenxing forward-port)
CONFIG_PINCTRL=y
CONFIG_PINCTRL_MSTAR=y
CONFIG_PINCTRL_MSC313=y
CONFIG_PINCTRL_MSC313_PM=y
CONFIG_GPIOLIB=y
CONFIG_GPIO_MSC313=y
CONFIG_SSD20XD_GPI=y
CONFIG_MSC313_PM_INTC=y
CONFIG_COMMON_CLK=y
CONFIG_MSTAR_MSC313_CPUPLL=y
CONFIG_MSTAR_MSC313_MPLL=y
CONFIG_MSTAR_MSC313_UPLL=y
CONFIG_MSTAR_MSC313_PM_MUXES=y
CONFIG_MSTAR_MSC313_CLKGEN=y
CONFIG_MSTAR_MSC313_SC_GP_CTRL_MUXES=y
CONFIG_MFD_SYSCON=y
CONFIG_POWER_RESET=y
CONFIG_POWER_RESET_SYSCON=y
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_MSC313=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_GENERIC_PHY=y
CONFIG_PHY_MSC313_USB=y
# No watchdog driver on purpose: the test loader arms the hardware
# watchdog as a hard deadline, and nothing may feed it.
CONFIG_WATCHDOG=n

# Console (pins unknown, harmless)
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_SERIAL_EARLYCON=y

# Network
CONFIG_NET=y
CONFIG_PACKET=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_IP_PNP=y
CONFIG_IP_PNP_DHCP=y
CONFIG_IP_MULTICAST=y
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_NET_VENDOR_CADENCE=y
CONFIG_PHYLIB=y
CONFIG_NET_CORE=y
CONFIG_NETCONSOLE=y
CONFIG_NETCONSOLE_DYNAMIC=y

# USB audio to the XMOS
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_EHCI_FUSBH200=y
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_USB=y
CONFIG_SND_USB_AUDIO=y

# Debug
CONFIG_MISC_FILESYSTEMS=y
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_MAGIC_SYSRQ=y
CONFIG_DEBUG_FS=y
CONFIG_DYNAMIC_DEBUG=y
CONFIG_MACB=y
CONFIG_MSC313_PHY=y
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SSTAR_SDIO=y
CONFIG_COMPAT_32BIT_TIME=y
CONFIG_VDSO=y

# systemd 252 / Debian 12 userland needs (allnoconfig drops these)
CONFIG_COREDUMP=y
CONFIG_SYSCTL=y
CONFIG_POSIX_MQUEUE=y
CONFIG_KCMP=y
CONFIG_CROSS_MEMORY_ATTACH=y
CONFIG_CHECKPOINT_RESTORE=y
CONFIG_PROC_CHILDREN=y
CONFIG_USER_NS=y
CONFIG_BLK_DEV=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_CRYPTO_SHA256=y
CONFIG_RTC_HCTOSYS=y
CONFIG_UNIX98_PTYS=y
# default-y options hidden behind EXPERT, which allnoconfig would drop
CONFIG_FILE_LOCKING=y
CONFIG_BUG=y
CONFIG_CACHESTAT_SYSCALL=y
CONFIG_PROC_PAGE_MONITOR=y
CONFIG_RSEQ=y
CONFIG_UID16=y
