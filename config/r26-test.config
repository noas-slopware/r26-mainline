# Test-only additions for loader (r26kexec) sessions. Never for production.
# CONFIG_INITRAMFS_SOURCE is set by build.sh to tools/bringup/initramfs/out/initramfs.list
CONFIG_DEBUG_KERNEL=y
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_DETECT_HUNG_TASK=y
CONFIG_DEFAULT_HUNG_TASK_TIMEOUT=10
CONFIG_DEVMEM=y
CONFIG_R26_MARKER=y
# No watchdog driver in loader test kernels: r26kexec arms the hardware
# watchdog as a hard deadline back to stock, and nothing may feed it.
CONFIG_WATCHDOG=n
